{
  "name": "langctl",
  "version": "0.4.0",
  "description": "Translation management CLI for developers: sync i18n files (JSON, Android, iOS, Flutter ARB) between your repo, CI and Langctl.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "langctl": "dist/index.js"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "bash test/e2e.sh",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "translation",
    "i18n",
    "internationalization",
    "localization",
    "l10n",
    "cli",
    "translations",
    "translate",
    "language",
    "multilingual",
    "translation-management",
    "localization-management",
    "translation-tool",
    "i18next",
    "developer-tools",
    "devtools",
    "dev-tool",
    "ios",
    "android",
    "flutter",
    "react",
    "angular",
    "vue",
    "react-native",
    "json",
    "xml",
    "arb",
    "strings",
    "automation",
    "ci-cd",
    "cicd",
    "continuous-integration",
    "workflow",
    "export",
    "import",
    "translation-export",
    "translation-import",
    "team",
    "collaboration",
    "multilanguage",
    "multi-language",
    "lokalise-alternative",
    "crowdin-alternative",
    "phrase-alternative",
    "affordable",
    "free",
    "gettext",
    "po",
    "locale",
    "translation-keys",
    "localization-tool",
    "string-management",
    "mobile-localization",
    "web-localization",
    "app-localization",
    "saas",
    "api"
  ],
  "author": "Siddharth Saxena <hello@langctl.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/litcode-pvt-ltd/langctl-cli.git"
  },
  "bugs": {
    "url": "https://github.com/litcode-pvt-ltd/langctl-cli/issues"
  },
  "homepage": "https://langctl.com",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.2"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ]
}
